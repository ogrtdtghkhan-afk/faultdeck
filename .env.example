# Copy this file to .env. Choose your own random password (at least 12 characters).
# There is deliberately no working default password.
FAULTDECK_ADMIN_USER=admin
FAULTDECK_ADMIN_PASSWORD=

# Optional separate client credential (at least 12 characters).
# Empty means use the admin password.
FAULTDECK_PROXY_TOKEN=

# Host ports stay bound to 127.0.0.1. Change these together with the URLs below.
FAULTDECK_UI_PORT=7331
FAULTDECK_PROXY_PORT=7332
FAULTDECK_UI_ORIGIN=http://127.0.0.1:7331
FAULTDECK_PROXY_URL=http://127.0.0.1:7332
